WECHAT_APPID=your_appid_here
WECHAT_APPSECRET=your_appsecret_here
WECHAT_API_BASE=https://api.weixin.qq.com
# File path to persist access_token across restarts; set to "" to disable.
WECHAT_TOKEN_CACHE_PATH=.wechat_token.json
# 公众号消息推送回调，关注门禁靠它实时维护关注者名单。
# 配置位置：微信开发者平台 developers.weixin.qq.com/platform
#   → 我的业务 → 公众号 → 基础信息 → 域名与消息推送配置 → 消息推送
#   URL 填 https://<域名>/wechat/callback，消息加密选「安全模式」，数据格式 XML
# 注意：启用后公众号后台的自动回复与自定义菜单会失效，消息全部转发到本服务。
WECHAT_CALLBACK_TOKEN=
WECHAT_AES_KEY=
# API key protecting /wechat/*, /mcp and /customer-service/* (callback exempt).
# Leave empty to disable auth (dev mode).
API_KEY=""
# HTTP header name; this is a public label, not a credential.
API_KEY_HEADER=X-API-Key
# 日志落盘目录；留空只打控制台。compose 会覆盖为 /data/log（绑到 ./data/log）
LOG_DIR=
LOG_LEVEL=INFO
# 日志总磁盘预算(MB)，由当前文件和 LOG_BACKUPS 个备份平分（50/5=每个10MB）
LOG_MAX_MB=50
LOG_BACKUPS=4
HOST=0.0.0.0
PORT=8000

# ---- 微信客服 (WeChat Customer Service) ----
# 「联合版」（已并入企业微信管理）：CorpID 取企业微信「我的企业-企业信息」，
# Secret 取被授权调用微信客服接口的那个"自建应用"的 Secret。
# 用独立版 kf.weixin.qq.com 的 Secret 调接口会报 95011 already use in wecom。
CS_CORPID=
CS_SECRET=
CS_API_BASE=https://qyapi.weixin.qq.com
# 开发配置处填写回调 URL 时自定义的 Token / EncodingAESKey
CS_CALLBACK_TOKEN=
CS_AES_KEY=
# sync_msg 增量游标持久化文件; "" 禁用（每次从头拉取）
CS_CURSOR_PATH=.cs_cursor.json
# 留空用默认的 Feyn OS 欢迎语
CS_WELCOME_TEXT=
# AI 问答仅对已关注公众号的客户开放。判据取自公众号
# user/get 关注者名单——客服侧的 unionid 判断不了关注状态（会话本身就会分配
# unionid，取关也不回收）。需要 WECHAT_APPID / WECHAT_APPSECRET 已正确配置。
# 设为 false 可临时放开。
CS_REQUIRE_FOLLOW=true
# 群二维码图片路径。设置后启用「进群」发码。
# Compose 内可设为 /data/customer-service/group.png。
CS_GROUP_QR_PATH=

# ---- DeepSeek — 客服机器人所用 LLM ----
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- PostgreSQL — 客户信息落库 ----
# 这三项供 docker-compose 起 db 服务并拼出 DATABASE_URL；生产务必改掉默认密码。
POSTGRES_USER=wechat
POSTGRES_PASSWORD=
POSTGRES_DB=wechat
# 仅本地不用 compose 直接跑时才需要手填；compose 会自动注入覆盖。
# AI 问答需要数据库记录每日额度。固定回复不依赖数据库。
DATABASE_URL=

# ---- 阿里云百炼 DashScope — 图片理解 / 语音识别 ----
# bailian.console.aliyun.com 获取；免费额度仅华北2(北京)地域有，Key 需与地域匹配。
DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# 图片理解模型（qwen3-vl-flash 最便宜，¥0.15/百万输入 token）
DASHSCOPE_VL_MODEL=qwen3-vl-flash
# 语音识别模型（qwen3-asr-flash 直接支持微信的 AMR，无需转码）
DASHSCOPE_ASR_MODEL=qwen3-asr-flash
# 语音识别语种；留空则由模型自动判别（客户以说普通话为主就保持 zh，更稳）
DASHSCOPE_ASR_LANGUAGE=zh
