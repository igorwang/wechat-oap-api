WECHAT_APPID=your_appid_here
WECHAT_APPSECRET=your_appsecret_here
WECHAT_API_BASE=https://api.weixin.qq.com
# File path to persist access_token across restarts; set to "" to disable.
WECHAT_TOKEN_CACHE_PATH=.wechat_token.json
# API key protecting /wechat/*, /mcp and /customer-service/* (callback exempt).
# Leave empty to disable auth (dev mode).
API_KEY=
API_KEY_HEADER=X-API-Key
HOST=0.0.0.0
PORT=8000

# ---- 微信客服 (WeChat Customer Service) — kf.weixin.qq.com 管理后台获取 ----
# 企业信息处的企业ID
CS_CORPID=
# 开发配置处的 Secret
CS_SECRET=
CS_API_BASE=https://qyapi.weixin.qq.com
# 开发配置处填写回调 URL 时自定义的 Token / EncodingAESKey
CS_CALLBACK_TOKEN=
CS_AES_KEY=
# sync_msg 增量游标持久化文件; "" 禁用（每次从头拉取）
CS_CURSOR_PATH=.cs_cursor.json
CS_WELCOME_TEXT=您好，我是智能客服助手，请问有什么可以帮您？

# ---- DeepSeek — 客服机器人所用 LLM ----
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_SYSTEM_PROMPT=你是一名专业、友善的客服助手，用简体中文简洁地回答客户问题。
